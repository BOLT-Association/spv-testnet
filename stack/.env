# Versions and host ports for the ChainBrowsers regtest stack. Override in stack/.env.local (gitignored).

COMPOSE_PROJECT_NAME=chainbrowsers

# Pinned to the digests verified together (Oct 2026): tx round trip with a valid BUMP, repeated reorgs.
# merkle-service's P2P client and block parser are coupled to Teranode's BlockMessage/block format (it was
# built against v0.15.2), so upgrade the three together and re-run tests/e2e and tests/reorg. To track
# upstream instead, drop the @sha256 part. If STUMPs stop arriving after an upgrade, pin TERANODE_IMAGE back.
TERANODE_IMAGE=ghcr.io/bsv-blockchain/teranode:latest@sha256:57a6706c069a70470ed9c3a9051cdf6d0074b2cad47de868fc9a331095711e10
MERKLE_IMAGE=ghcr.io/bsv-blockchain/merkle-service:latest@sha256:fe08879ccc55ecbe3880107d82d329805ee6b617be0d7662a9656b40252461ec
ARCADE_IMAGE=ghcr.io/bsv-blockchain/arcade:latest@sha256:52a12ba70b6152ff4fce85664d608fa239bb1c98954a4143f10e232bf18653f8

# Host ports
TERANODE_RPC_PORT=29292
TERANODE_ASSET_PORT=28090
TERANODE_HEALTH_PORT=28000
ARCADE_API_PORT=8080
ARCADE_HEALTH_PORT=8081
ARCADE_CHAINTRACKS_PORT=8083
ARCADE_SSE_PORT=8082
MERKLE_PORT=8086
POSTGRES_PORT=25433
