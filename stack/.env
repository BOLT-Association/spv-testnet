# Versions and host ports for the ChainBrowsers regtest stack. Override in stack/.env.local (gitignored).

COMPOSE_PROJECT_NAME=chainbrowsers

# NOTE: merkle-service's P2P client was built against teranode v0.15.2; if STUMPs stop arriving on a newer
# teranode, pin TERANODE_IMAGE back to ...:v0.15.2 (or bump merkle-service to match).
TERANODE_IMAGE=ghcr.io/bsv-blockchain/teranode:latest
MERKLE_IMAGE=ghcr.io/bsv-blockchain/merkle-service:latest
ARCADE_IMAGE=ghcr.io/bsv-blockchain/arcade:latest

# Host ports
TERANODE_RPC_PORT=29292
TERANODE_ASSET_PORT=28090
TERANODE_HEALTH_PORT=28000
ARCADE_API_PORT=8080
ARCADE_HEALTH_PORT=8081
ARCADE_CHAINTRACKS_PORT=8083
MERKLE_PORT=8086
POSTGRES_PORT=25433
